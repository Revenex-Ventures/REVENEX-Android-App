{
  "name": "revenex-erp-functions",
  "version": "1.0.0",
  "description": "Secure Serverless Intermediary Backend for REVENEX School ERP",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "test:rules": "firebase emulators:exec --only firestore --project demo-revenex \"node test/run-rules-tests.js\"",
    "check": "node --check index.js && node --check src/config.js && node --check src/logger.js && node --check src/monitor.js && node --check src/claims.js && node --check src/provision.js"
  },
  "dependencies": {
    "@sentry/node": "^8.30.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "razorpay": "^2.9.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-tools": "^13.15.0"
  },
  "private": true
}