<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">#F8F7F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#AD3F00</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Revenex.Dark" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#1D2228</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#FFB681</item>
    </style>
    <style name="Theme.Revenex.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090C12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/revenex_launch_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Revenex.Starting.Dark" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090C12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/revenex_launch_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.Revenex.Dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Revenex.Starting.Light" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090C12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/revenex_launch_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
