<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A common branded launch surface avoids a white launch preview before
         the stored Compose appearance is restored. It is not app content. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">#F7F8F4</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#006B61</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">#006B61</item>
    </style>
    <style name="Theme.Revenex.Dark" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#102321</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#75D7C5</item>
        <item name="android:windowSplashScreenBackground">#006B61</item>
    </style>
</resources>
