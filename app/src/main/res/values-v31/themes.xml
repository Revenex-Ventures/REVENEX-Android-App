<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A common branded launch surface avoids a white launch preview before
         the stored Compose appearance is restored. It is not app content. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">#FFF9F0</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#AD3F00</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">#AD3F00</item>
    </style>
    <style name="Theme.Revenex.Dark" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#211D19</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#FFB681</item>
        <item name="android:windowSplashScreenBackground">#AD3F00</item>
    </style>
</resources>
